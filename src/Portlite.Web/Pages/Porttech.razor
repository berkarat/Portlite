@page "/porttech"
@inject ApiClient Api
@inject PortfolioStore Store
@implements IDisposable

<PageTitle>Portlite — Porttech</PageTitle>

<div class="page-title-row">
    <div class="page-title-row__main">
        <h1 class="page-title">Porttech Raporları</h1>
        <div class="eyebrow">Günlük portföy teknik analizi — RSI, SMA, TC Skoru</div>
    </div>
    <div class="btn-row" style="margin-bottom:0; gap:10px; align-items:center;">
        @if (_history is { Count: > 0 })
        {
            <select class="porttech-date-select" @onchange="OnDateChanged">
                @foreach (var r in _history)
                {
                    <option value="@r.Id" selected="@(r.Id == _selectedReport?.Id)">
                        @r.ReportDate.ToString("yyyy-MM-dd") · @r.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </option>
                }
            </select>
        }
        <button class="btn btn--accent" @onclick="GenerateAsync" disabled="@_generating">
            @(_generating ? "Üretiliyor…" : "⬢ Yeni Rapor Üret")
        </button>
    </div>
</div>

<PortfolioChips />

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="panel" style="border-left:4px solid var(--danger); margin-bottom:16px;">
        <div class="panel__body--padded" style="color:var(--danger);">
            <strong>Hata:</strong> @_errorMessage
        </div>
    </div>
}

@if (Store.Selected is null)
{
    <div class="empty">Bir alt portföy seç.</div>
}
else if (_loading)
{
    <div class="panel"><div class="panel__body--padded"><div class="skeleton" style="height:400px;"></div></div></div>
}
else if (_selectedReport is null)
{
    <div class="panel">
        <div class="panel__body--padded" style="text-align:center; padding:60px 20px;">
            <h2 style="color:var(--text-secondary); margin-bottom:12px;">Henüz rapor yok</h2>
            <p style="color:var(--text-muted);">İlk teknik analiz raporunu üretmek için yukarıdaki butonu kullan.</p>
        </div>
    </div>
}
else
{
    <div class="porttech-report">
        @* Header *@
        <div class="panel porttech-summary">
            <div class="panel__body--padded">
                <h2 class="porttech-section-title">Porttech · Portföy Teknik Analiz</h2>
                <div class="porttech-meta">
                    @_selectedReport.ReportDate.ToString("dd MMMM yyyy", _trCulture) · 
                    @_selectedReport.CreatedAt.ToLocalTime().ToString("HH:mm") ·
                    @(_parsedReport?.PositionSummary?.Count ?? 0) pozisyon
                </div>
            </div>
        </div>

        @* 3 Summary Badges *@
        @if (_parsedReport?.ExecGrid is not null)
        {
            <div class="porttech-badges-row">
                @* Genel Tablo *@
                <div class="porttech-badge-card porttech-badge-card--info">
                    <div class="porttech-badge-card__icon">📊</div>
                    <div class="porttech-badge-card__content">
                        <div class="porttech-badge-card__title">Genel Tablo</div>
                        <div class="porttech-badge-card__text">
                            @(_parsedReport.ContextBox?.PositionCount ?? _parsedReport.PositionSummary?.Count ?? 0) pozisyon,
                            @(_parsedReport.ExecGrid.BelowCostCount) maliyetin altında
                            · Nakit @(_parsedReport.ContextBox?.CashPct ?? "—")
                            (@(_parsedReport.ContextBox?.CashStance ?? "—"))
                        </div>
                    </div>
                </div>
                @* Kritik *@
                <div class="porttech-badge-card porttech-badge-card--danger">
                    <div class="porttech-badge-card__icon">⚠️</div>
                    <div class="porttech-badge-card__content">
                        <div class="porttech-badge-card__title">Kritik</div>
                        <div class="porttech-badge-card__text">
                            @if (_parsedReport.ExecGrid.BelowEma50Symbols is { Count: > 0 })
                            {
                                @string.Join(", ", _parsedReport.ExecGrid.BelowEma50Symbols)
                                <span> EMA50 altında</span>
                            }
                            else
                            {
                                <span>EMA50 altında pozisyon yok</span>
                            }
                        </div>
                    </div>
                </div>
                @* Güçlü Tutan *@
                <div class="porttech-badge-card porttech-badge-card--success">
                    <div class="porttech-badge-card__icon">✅</div>
                    <div class="porttech-badge-card__content">
                        <div class="porttech-badge-card__title">Güçlü Tutan</div>
                        <div class="porttech-badge-card__text">
                            @if (_parsedReport.ExecGrid.TcAbove85Symbols is { Count: > 0 })
                            {
                                @foreach (var sym in _parsedReport.ExecGrid.TcAbove85Symbols)
                                {
                                    var pos = _parsedReport.PositionSummary?.FirstOrDefault(p => p.Symbol == sym);
                                    if (pos is not null)
                                    {
                                        <span class="porttech-strong-sym">@sym @(pos.UnrealizedPnl >= 0 ? "+" : "")$@pos.UnrealizedPnl.ToString("N0")</span>
                                    }
                                }
                                <span> — trend bozulmadı</span>
                            }
                            else
                            {
                                <span>TC ≥ 85 pozisyon yok</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        @* Portföy Bağlamı *@
        @if (_parsedReport?.ContextBox is not null)
        {
            <h3 class="porttech-section-title" style="margin-top:24px;">Portföy Bağlamı</h3>
            <div class="porttech-context-box">
                <div class="porttech-ctx-item">
                    <span class="porttech-ctx-label">Toplam Varlık</span>
                    <span class="porttech-ctx-value">@_parsedReport.ContextBox.TotalEquity</span>
                </div>
                <div class="porttech-ctx-item">
                    <span class="porttech-ctx-label">Pozisyon Değeri</span>
                    <span class="porttech-ctx-value">@_parsedReport.ContextBox.PositionValue</span>
                </div>
                <div class="porttech-ctx-item">
                    <span class="porttech-ctx-label">Nakit</span>
                    <span class="porttech-ctx-value">@_parsedReport.ContextBox.CashBalance (@_parsedReport.ContextBox.CashPct)</span>
                </div>
                <div class="porttech-ctx-item">
                    <span class="porttech-ctx-label">Pozisyon Sayısı</span>
                    <span class="porttech-ctx-value">@_parsedReport.ContextBox.PositionCount</span>
                </div>
                <div class="porttech-ctx-item">
                    <span class="porttech-ctx-label">Nakit Tavrı</span>
                    <span class="porttech-ctx-value porttech-stance--@_parsedReport.ContextBox.CashStance">@_parsedReport.ContextBox.CashStance</span>
                </div>
            </div>
        }

        @* Executive Summary *@
        @if (!string.IsNullOrEmpty(_parsedReport?.ExecutiveSummary))
        {
            <div class="porttech-exec-summary" style="margin-top:16px;">@_parsedReport.ExecutiveSummary</div>
        }

        @* Exec Grid *@
        @if (_parsedReport?.ExecGrid is not null)
        {
            <h3 class="porttech-section-title" style="margin-top:24px;">Yönetici Özeti</h3>
            <div class="porttech-exec-grid">
                <div class="porttech-grid-card porttech-grid-card--red">
                    <div class="porttech-grid-num">@_parsedReport.ExecGrid.RsiOverboughtCount</div>
                    <div class="porttech-grid-label">RSI ≥ 70</div>
                    <div class="porttech-grid-detail">@string.Join(", ", _parsedReport.ExecGrid.RsiOverboughtSymbols ?? [])</div>
                </div>
                <div class="porttech-grid-card porttech-grid-card--green">
                    <div class="porttech-grid-num">@_parsedReport.ExecGrid.Near52hCount</div>
                    <div class="porttech-grid-label">52H Zirve ±5%</div>
                    <div class="porttech-grid-detail">@string.Join(", ", _parsedReport.ExecGrid.Near52hSymbols ?? [])</div>
                </div>
                <div class="porttech-grid-card porttech-grid-card--orange">
                    <div class="porttech-grid-num">@_parsedReport.ExecGrid.BelowEma50Count</div>
                    <div class="porttech-grid-label">EMA50 Altı</div>
                    <div class="porttech-grid-detail">@string.Join(", ", _parsedReport.ExecGrid.BelowEma50Symbols ?? [])</div>
                </div>
                <div class="porttech-grid-card porttech-grid-card--red">
                    <div class="porttech-grid-num">@_parsedReport.ExecGrid.TcBelow40Count</div>
                    <div class="porttech-grid-label">TC &lt; 40 (Bitmiş)</div>
                    <div class="porttech-grid-detail">@string.Join(", ", _parsedReport.ExecGrid.TcBelow40Symbols ?? [])</div>
                </div>
                <div class="porttech-grid-card porttech-grid-card--blue">
                    <div class="porttech-grid-num">@_parsedReport.ExecGrid.TcAbove85Count</div>
                    <div class="porttech-grid-label">TC ≥ 85 (Güçlü)</div>
                    <div class="porttech-grid-detail">@string.Join(", ", _parsedReport.ExecGrid.TcAbove85Symbols ?? [])</div>
                </div>
                <div class="porttech-grid-card porttech-grid-card--orange">
                    <div class="porttech-grid-num">@_parsedReport.ExecGrid.BelowCostCount</div>
                    <div class="porttech-grid-label">Maliyet Altı</div>
                    <div class="porttech-grid-detail">@string.Join(", ", _parsedReport.ExecGrid.BelowCostSymbols ?? [])</div>
                </div>
            </div>
        }

        @* Alerts *@
        @if (_parsedReport?.Alerts is { Count: > 0 })
        {
            <h3 class="porttech-section-title" style="margin-top:24px;">🚨 Kritik Uyarılar</h3>
            <div class="porttech-alerts">
                @foreach (var alert in _parsedReport.Alerts)
                {
                    <div class="porttech-alert porttech-alert--@alert.Severity">
                        <div class="porttech-alert__badge">@(string.IsNullOrEmpty(alert.Category) ? SeverityLabel(alert.Severity) : alert.Category)</div>
                        <div class="porttech-alert__symbol">@alert.Symbol</div>
                        <div class="porttech-alert__msg">@alert.Message</div>
                    </div>
                }
            </div>
        }

        @* Actions Table *@
        @if (_parsedReport?.Actions is { Count: > 0 })
        {
            <h3 class="porttech-section-title" style="margin-top:24px;">📋 Önerilen Aksiyonlar</h3>
            <div class="panel" style="overflow-x:auto;">
                <table class="dt">
                    <thead>
                        <tr>
                            <th>Ticker</th>
                            <th>Aksiyon</th>
                            <th>Gerekçe</th>
                            <th>Stop Seviyesi</th>
                            <th>Hedef / Reclaim</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in _parsedReport.Actions)
                        {
                            <tr>
                                <td><strong>@a.Symbol</strong></td>
                                <td><span class="porttech-action-badge @ActionClass(a.Action)">@a.Action</span></td>
                                <td class="porttech-reasoning">
                                    @a.Reasoning
                                    @if (!string.IsNullOrEmpty(a.Yani))
                                    {
                                        <div class="porttech-yani">💬 yani: @a.Yani</div>
                                    }
                                </td>
                                <td class="porttech-stop">@(a.StopLevel ?? "—")</td>
                                <td class="porttech-target">@(a.TargetOrReclaim ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @* Position Summary Table *@
        @if (_parsedReport?.PositionSummary is { Count: > 0 })
        {
            <h3 class="porttech-section-title" style="margin-top:24px;">📊 Pozisyon Özeti</h3>
            <div class="panel" style="overflow-x:auto;">
                <table class="dt">
                    <thead>
                        <tr>
                            <th>Ticker</th>
                            <th>Fiyat</th>
                            <th>Maliyet</th>
                            <th>K/Z</th>
                            <th>K/Z %</th>
                            <th>TC</th>
                            <th>RSI</th>
                            <th>EMA21</th>
                            <th>EMA50</th>
                            <th>EMA50 %</th>
                            <th>200MA</th>
                            <th>52H</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in _parsedReport.PositionSummary.OrderByDescending(x => x.TcScore))
                        {
                            <tr>
                                <td><strong>@p.Symbol</strong></td>
                                <td>$@p.CurrentPrice.ToString("N2")</td>
                                <td>$@p.AvgCost.ToString("N2")</td>
                                <td class="@DeltaClass(p.UnrealizedPnl)">@(p.UnrealizedPnl >= 0 ? "+" : "")$@p.UnrealizedPnl.ToString("N0")</td>
                                <td class="@DeltaClass(p.PnlPct)">@FormatPct(p.PnlPct)</td>
                                <td><span class="porttech-tc @TcClass(p.TcScore)">@p.TcScore</span></td>
                                <td>@p.Rsi.ToString("N1")</td>
                                <td>$@p.Ema21.ToString("N2")</td>
                                <td>$@p.Ema50.ToString("N2")</td>
                                <td class="@DeltaClass(p.Ema50DistPct)">@FormatPct(p.Ema50DistPct)</td>
                                <td>@FormatMa(p.Sma200)</td>
                                <td>@FormatMa(p.High52w)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @* Summary Note *@
        @if (!string.IsNullOrEmpty(_parsedReport?.SummaryNote))
        {
            <div class="porttech-summary-note">
                <strong>Özet:</strong> @_parsedReport.SummaryNote
            </div>
        }

        @* Terimler Sözlüğü *@
        <details class="porttech-glossary">
            <summary class="porttech-glossary__toggle">📖 Terimler Sözlüğü</summary>
            <div class="porttech-glossary__body">
                <ul class="porttech-glossary__list">
                    <li><strong>TC (Trend Composite):</strong> 0-100 arası teknik skor. RSI, EMA50 mesafesi, 200MA mesafesi ve 52H mesafesini birleştirir. ≥85 Güçlü · 60-84 Sağlıklı · 40-59 Zayıf · &lt;40 Bitmiş</li>
                    <li><strong>EMA21 / EMA50:</strong> Üssel Hareketli Ortalama. Son fiyatlara daha fazla ağırlık verir. EMA21 kısa vade, EMA50 orta vade trend çizgisi.</li>
                    <li><strong>SMA200:</strong> 200 günlük Basit Hareketli Ortalama. Uzun vadeli trend — fiyat üstündeyse boğa, altındaysa ayı.</li>
                    <li><strong>RSI:</strong> 14 günlük göreceli güç endeksi. ≥70 aşırı alım, ≤30 aşırı satım, ~50 nötr.</li>
                    <li><strong>52H:</strong> Son 1 yılın en yüksek fiyatı. Yakınlık = momentum gücü.</li>
                    <li><strong>Stop Seviyesi:</strong> Bu fiyatın altında kapanırsa pozisyondan çıkış önerilir.</li>
                    <li><strong>Hedef / Reclaim:</strong> Fiyat bu seviyeyi geri kazanırsa güven verir veya ek alım noktası olur.</li>
                    <li><strong>HOLD / CONFLUENCE:</strong> Tut — teknik göstergeler uyumlu, pozisyon sağlıklı.</li>
                    <li><strong>STOP SIKILAŞTIR:</strong> Stop'u yukarı çek — risk var ama henüz çıkış sinyali yok.</li>
                    <li><strong>AZALT:</strong> Lot küçült veya pozisyonu kapat — teknik bozulma belirgin.</li>
                    <li><strong>Nakit Tavrı:</strong> ≥%15 savunmacı · %5-15 nötr · &lt;%5 agresif.</li>
                </ul>
            </div>
        </details>

        @* Token usage *@
        <div class="porttech-footer">
            Token: @_selectedReport.InputTokens in / @_selectedReport.OutputTokens out
        </div>
    </div>
}

@code {
    private static readonly System.Globalization.CultureInfo _trCulture = new("tr-TR");

    private bool _loading;
    private bool _generating;
    private string? _errorMessage;
    private List<PorttechReportDto>? _history;
    private PorttechReportDto? _selectedReport;
    private ParsedPorttechReport? _parsedReport;

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnStoreChanged;
        if (Store.Portfolios.Count == 0)
            await Store.RefreshAsync();
        else
            await LoadAsync();
    }

    private async void OnStoreChanged()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        if (Store.SelectedId is null) return;
        _loading = true;
        StateHasChanged();

        try
        {
            _history = await Api.GetPorttechHistoryAsync(Store.SelectedId.Value, 20);
            _selectedReport = _history?.FirstOrDefault();
            ParseReport();
        }
        catch { _history = null; _selectedReport = null; }
        finally { _loading = false; StateHasChanged(); }
    }

    private async Task GenerateAsync()
    {
        if (Store.SelectedId is null) return;
        _generating = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            _selectedReport = await Api.GeneratePorttechAsync(Store.SelectedId.Value);
            _history = await Api.GetPorttechHistoryAsync(Store.SelectedId.Value, 20);
            ParseReport();
        }
        catch (TaskCanceledException)
        {
            _errorMessage = "Rapor üretimi zaman aşımına uğradı. Sayfa yenilendiğinde rapor görünebilir.";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Rapor üretilirken hata: {ex.Message}";
            Console.WriteLine($"Porttech generate error: {ex.Message}");
        }
        finally { _generating = false; StateHasChanged(); }
    }

    private async Task OnDateChanged(ChangeEventArgs e)
    {
        if (e.Value is string idStr && Guid.TryParse(idStr, out var id))
        {
            _selectedReport = _history?.FirstOrDefault(r => r.Id == id);
            ParseReport();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ParseReport()
    {
        if (_selectedReport is null || string.IsNullOrEmpty(_selectedReport.ReportJson))
        {
            _parsedReport = null;
            return;
        }
        try
        {
            var json = _selectedReport.ReportJson.Trim();
            // Strip markdown code fences if AI wrapped them
            if (json.StartsWith("```"))
            {
                var firstNewline = json.IndexOf('\n');
                var lastFence = json.LastIndexOf("```");
                if (firstNewline > 0 && lastFence > firstNewline)
                    json = json[(firstNewline + 1)..lastFence].Trim();
            }
            _parsedReport = System.Text.Json.JsonSerializer.Deserialize<ParsedPorttechReport>(
                json, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web));
        }
        catch (Exception ex)
        {
            _parsedReport = null;
            _errorMessage = $"Rapor parse hatası: {ex.Message}";
            Console.WriteLine($"ParseReport error: {ex.Message}\nReportJson preview: {_selectedReport.ReportJson?[..Math.Min(200, _selectedReport.ReportJson?.Length ?? 0)]}");
        }
    }

    private static string SeverityLabel(string s) => s switch
    {
        "kritik" => "Kritik",
        "uyari" => "Uyarı",
        "bilgi" => "Bilgi",
        "firsat" => "Fırsat",
        _ => s
    };

    private static string ActionClass(string a) => a switch
    {
        _ when a.Contains("STOP") => "action--red",
        _ when a.Contains("HOLD") => "action--green",
        _ when a.Contains("İZLE") => "action--blue",
        _ when a.Contains("AZALT") => "action--orange",
        _ => ""
    };

    private static string DeltaClass(decimal v) => v > 0 ? "tag-pos" : v < 0 ? "tag-neg" : "";
    private static string FormatPct(decimal v) => $"{(v > 0 ? "+" : "")}{v:N2}%";
    private static string FormatMa(decimal v) => v > 0 ? $"${v:N2}" : "—";
    private static string TcClass(int score) => score >= 85 ? "tc--strong" : score >= 60 ? "tc--healthy" : score >= 40 ? "tc--weak" : "tc--dead";

    public void Dispose() => Store.Changed -= OnStoreChanged;

    // JSON model for AI report
    private class ParsedPorttechReport
    {
        [System.Text.Json.Serialization.JsonPropertyName("executive_summary")]
        public string? ExecutiveSummary { get; set; }

        [System.Text.Json.Serialization.JsonPropertyName("context_box")]
        public ContextBoxModel? ContextBox { get; set; }

        [System.Text.Json.Serialization.JsonPropertyName("exec_grid")]
        public ExecGridModel? ExecGrid { get; set; }

        [System.Text.Json.Serialization.JsonPropertyName("alerts")]
        public List<AlertModel>? Alerts { get; set; }

        [System.Text.Json.Serialization.JsonPropertyName("actions")]
        public List<ActionModel>? Actions { get; set; }

        [System.Text.Json.Serialization.JsonPropertyName("position_summary")]
        public List<PositionSummaryModel>? PositionSummary { get; set; }

        [System.Text.Json.Serialization.JsonPropertyName("summary_note")]
        public string? SummaryNote { get; set; }
    }

    private class ContextBoxModel
    {
        [System.Text.Json.Serialization.JsonPropertyName("total_equity")]
        public string TotalEquity { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("position_value")]
        public string PositionValue { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("cash_balance")]
        public string CashBalance { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("cash_pct")]
        public string CashPct { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("position_count")]
        public int PositionCount { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("cash_stance")]
        public string CashStance { get; set; } = "";
    }

    private class ExecGridModel
    {
        [System.Text.Json.Serialization.JsonPropertyName("rsi_overbought_count")]
        public int RsiOverboughtCount { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("near_52h_count")]
        public int Near52hCount { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("below_ema50_count")]
        public int BelowEma50Count { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("below_cost_count")]
        public int BelowCostCount { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("tc_below_40_count")]
        public int TcBelow40Count { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("tc_above_85_count")]
        public int TcAbove85Count { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("rsi_overbought_symbols")]
        public List<string>? RsiOverboughtSymbols { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("near_52h_symbols")]
        public List<string>? Near52hSymbols { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("below_ema50_symbols")]
        public List<string>? BelowEma50Symbols { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("below_cost_symbols")]
        public List<string>? BelowCostSymbols { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("tc_below_40_symbols")]
        public List<string>? TcBelow40Symbols { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("tc_above_85_symbols")]
        public List<string>? TcAbove85Symbols { get; set; }
    }

    private class AlertModel
    {
        [System.Text.Json.Serialization.JsonPropertyName("category")]
        public string Category { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("severity")]
        public string Severity { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("symbol")]
        public string Symbol { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("message")]
        public string Message { get; set; } = "";
    }

    private class ActionModel
    {
        [System.Text.Json.Serialization.JsonPropertyName("symbol")]
        public string Symbol { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("action")]
        public string Action { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("reasoning")]
        public string Reasoning { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("stop_level")]
        public string? StopLevel { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("target_or_reclaim")]
        public string? TargetOrReclaim { get; set; }
