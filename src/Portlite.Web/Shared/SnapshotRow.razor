<div class="snapshot-row @(Bold ? "snapshot-row--bold" : "")">
    <span class="snapshot-row__label">@Label</span>
    <span class="snapshot-row__value num @Tone">@Value</span>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter] public string? Tone { get; set; }
    [Parameter] public bool Bold { get; set; }
}
