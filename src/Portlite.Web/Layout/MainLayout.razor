@inherits LayoutComponentBase

<div class="shell">
    <button class="sidebar-toggle" @onclick="ToggleSidebar">☰</button>
    <aside class="sidebar @(_sidebarOpen ? "sidebar--open" : "")">
        <div class="sidebar__header">
            <div class="sidebar__brand">
                <span class="sidebar__brand-main">Portföy</span>
                <span class="sidebar__brand-sub">Platform</span>
            </div>
            <button class="sidebar__close" @onclick="ToggleSidebar">×</button>
        </div>

        <div class="sidebar__group-label">Görünüm</div>
        <nav class="sidebar__nav">
            <NavLink href="" Match="NavLinkMatch.All" class="sidebar__link">
                <span class="sidebar__icon sidebar__icon--green">◉</span><span>Portföy</span>
            </NavLink>
            <NavLink href="pozisyonlar" class="sidebar__link">
                <span class="sidebar__icon sidebar__icon--teal">☰</span><span>Pozisyonlar</span>
            </NavLink>
            <NavLink href="trades" class="sidebar__link">
                <span class="sidebar__icon sidebar__icon--blue">⇄</span><span>Geçmiş İşlemler</span>
            </NavLink>
            <NavLink href="watchlist" class="sidebar__link">
                <span class="sidebar__icon sidebar__icon--gold">☆</span><span>Watchlist</span>
            </NavLink>
            <NavLink href="haberler" class="sidebar__link">
                <span class="sidebar__icon sidebar__icon--gold">✦</span><span>Haberler</span>
            </NavLink>
            <NavLink href="porttech" class="sidebar__link">
                <span class="sidebar__icon sidebar__icon--teal">⬢</span><span>Porttech</span>
            </NavLink>
        </nav>

        <div class="sidebar__group-label">Yönetim</div>
        <nav class="sidebar__nav">
            <NavLink href="portfolios" class="sidebar__link">
                <span class="sidebar__icon sidebar__icon--purple">▤</span><span>Portföyler</span>
            </NavLink>
            <NavLink href="cash" class="sidebar__link">
                <span class="sidebar__icon sidebar__icon--green">$</span><span>Nakit</span>
            </NavLink>
            <NavLink href="assets" class="sidebar__link">
                <span class="sidebar__icon sidebar__icon--purple">◇</span><span>Varlık Kataloğu</span>
            </NavLink>
        </nav>
    </aside>

    <main class="main">
        @Body
    </main>
</div>

@code {
    private bool _sidebarOpen;
    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;
}
